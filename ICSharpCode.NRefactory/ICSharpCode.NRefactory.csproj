<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ICSharpCode.NRefactory</RootNamespace>
    <AssemblyName>ICSharpCode.NRefactory</AssemblyName>
    
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <NoWarn>1591</NoWarn>
    
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ensure DocumentationFile path matches the old structure, relative to project file -->
    <DocumentationFile>..\bin\$(Configuration)\$(AssemblyName).xml</DocumentationFile> 
    
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\ICSharpCode.NRefactory.snk</AssemblyOriginatorKeyFile>
    <DelaySign>False</DelaySign>
    
    <!-- Set OutputPath to match the old structure (e.g., ..\bin\Debug\) -->
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <!-- Prevent SDK from appending TargetFramework to the OutputPath (e.g. ..\bin\Debug\netstandard2.0\) -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)'=='Debug' ">
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <!-- Other Debug properties like DebugSymbols, DefineConstants (DEBUG;TRACE), Optimize (false), DebugType (full) are typically default -->
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)'=='Release' ">
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <!-- Other Release properties like DefineConstants (TRACE), Optimize (true), DebugType (PdbOnly) are typically default -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\doc\Pattern Matching.html">
      <Link>PatternMatching\Pattern Matching.html</Link>
    </None>
    <None Include="..\doc\XML Documentation.html">
      <Link>Documentation\XML Documentation.html</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
    <PackageReference Include="System.Security.Permissions" Version="4.7.0" />
  </ItemGroup>

</Project>